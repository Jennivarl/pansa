{
  "name": "@pansapay/demo",
  "version": "0.1.0",
  "private": true,
  "description": "A paid API that takes private x402 payments on Arc, and an agent that buys from it",
  "type": "module",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "api": "tsx src/api.ts",
    "agent": "tsx src/agent.ts",
    "seller": "tsx src/seller.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-circle": "tsx src/check-circle.ts",
    "spend": "tsx src/spend.ts",
    "build": "tsc -p tsconfig.build.json",
    "pay": "tsx src/pay.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@pansapay/core": "0.1.0",
    "@pansapay/x402": "0.1.0",
    "hono": "^4.6.0",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
